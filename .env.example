# Copy to .env.local and fill in once the Supabase project exists.
# Never commit the real .env.local — it's git-ignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://sooriyabooks.lk

# --- Google Sign-In (One Tap) ---
# OAuth Client ID from the Google Cloud Console, for the Google Identity
# Services web SDK — matches the Google provider already configured in
# Supabase Auth. Public by design (client IDs are not secret); never put
# a Google client SECRET here or anywhere in the browser bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Payments: Bank IPG (Sampath Bank's Paycorp-hosted gateway — the real
# gateway the legacy site used) ---
BANK_IPG_CLIENT_ID=
BANK_IPG_AUTH_TOKEN=
BANK_IPG_HMAC_SECRET=
# Optional — defaults to Sampath's live endpoint (https://sampath.paycorp.lk/rest/service/proxy).
# Override with a sandbox URL if Sampath provides one for testing.
BANK_IPG_ENDPOINT=

# --- Optional: error reporting ---
SENTRY_DSN=

# Copy to .env.local and fill in once the Supabase project exists.
# Never commit the real .env.local — it's git-ignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://sooriyabooks.lk

# --- Google Sign-In (One Tap) ---
# OAuth Client ID from the Google Cloud Console, for the Google Identity
# Services web SDK — matches the Google provider already configured in
# Supabase Auth. Public by design (client IDs are not secret); never put
# a Google client SECRET here or anywhere in the browser bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID='1009061421088-9jv5m7cv93qklh8qtlllehdoohi0b6ac.apps.googleusercontent.com'

# --- Payments: Bank IPG (Sampath Bank) ---
BANK_IPG_MERCHANT_ID=
BANK_IPG_SECRET=
BANK_IPG_ENV=sandbox

# --- Optional: error reporting ---
SENTRY_DSN=

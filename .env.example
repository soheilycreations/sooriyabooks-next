# Copy to .env.local and fill in once the Supabase project exists.
# Never commit the real .env.local — it's git-ignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
